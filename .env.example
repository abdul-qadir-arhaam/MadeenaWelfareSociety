# ====================================================================
# Madeena Welfare Society — Environment Configuration Template
# Copy this file to .env.local for local development or configure
# these keys in the Vercel Project Settings > Environment Variables
# ====================================================================

# 1. Site URL (Used for Canonical URLs, Open Graph, Sitemap & Robots.txt)
# Local: http://localhost:3000
# Production: https://your-project.vercel.app or https://madeenawelfaresociety.org
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 2. Supabase Configuration (Public Client & Server SSR)
# Found in: Supabase Project Settings > API > Project URL & anon/public key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# 3. Supabase Service Role Key (Server-only Admin Client for media & backups)
# WARNING: Keep this strictly secret! Never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 4. Admin CMS Credentials (Fallback authentication & initial superadmin)
ADMIN_EMAIL=admin@madeenaws.bhatkal.org
ADMIN_PASSWORD=Madeena@Admin2026
